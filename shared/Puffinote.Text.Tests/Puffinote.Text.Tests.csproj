<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the shared text library. They travelled with the code out of Typage.Engine.Tests
    (proposal 0003 Phase 0) — the piece table, grapheme navigation, selection, undo, search, and the
    file codec are format-agnostic, so their tests are too. xUnit v3, no UI.

    This project is in all four solutions, because the library is.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Puffinote.Text.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Puffinote.Text\Puffinote.Text.csproj" />
  </ItemGroup>

</Project>
