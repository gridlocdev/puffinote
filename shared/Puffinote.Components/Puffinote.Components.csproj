<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Puffinote.Components — the shared app-shell / design-system library for the Puffinote family
    (Cellestra, Typage, and the future Puffinote composite app). See
    docs/proposals/0001-puffinote-components.md.

    It will hold the command-system primitives, design tokens, and UI chrome (palette, modals,
    tooltips) so the apps share one look and one set of patterns. Dependency rule: this library
    references Avalonia and its own code only — never an app, engine, or editing surface. Apps
    reference it. (Target framework, nullable, and package versions come from the repo-root
    Directory.Build.props / Directory.Packages.props.)
  -->
  <PropertyGroup>
    <RootNamespace>Puffinote.Components</RootNamespace>
    <AssemblyName>Puffinote.Components</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <!-- The vendored Lucide SVG glyphs (avares://Puffinote.Components/Assets/icons/...). -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!--
      This library has no test project of its own — it is compiled into every solution, so its controls
      are exercised from whichever area's UI suite hosts them (the pattern Puffinote.Text already uses).
      Puffinote.UiTests is where the shared chrome is covered.
    -->
    <InternalsVisibleTo Include="Puffinote.UiTests" />
  </ItemGroup>

</Project>
