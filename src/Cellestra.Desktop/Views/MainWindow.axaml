<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:grid="clr-namespace:Cellestra.Desktop.Controls.SpreadsheetGrid"
        x:Class="Cellestra.Desktop.Views.MainWindow"
        Title="Cellestra"
        Width="1100" Height="720"
        MinWidth="640" MinHeight="400">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- Ribbon (hidden by default, PRD §6) -->
        <ContentControl x:Name="RibbonHost" Grid.Row="0" IsVisible="False" />

        <!-- Formula bar: Name Box, fx, formula input -->
        <Border Grid.Row="1" Background="{DynamicResource ChromeBackground}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,0,0,1" Padding="4">
            <DockPanel>
                <TextBox x:Name="NameBox" Width="92" DockPanel.Dock="Left" PlaceholderText="A1"
                         VerticalContentAlignment="Center" />
                <Button x:Name="FxButton" DockPanel.Dock="Left" Content="fx" Margin="4,0"
                        FontStyle="Italic" Width="30" />
                <TextBox x:Name="FormulaInput" VerticalContentAlignment="Center" Margin="2,0,0,0" />
            </DockPanel>
        </Border>

        <!-- The custom grid -->
        <grid:SpreadsheetGrid x:Name="Grid" Grid.Row="2" />

        <!-- Sheet tab strip -->
        <Border Grid.Row="3" Background="{DynamicResource ChromeAltBackground}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,1,0,0" Padding="4,2">
            <StackPanel x:Name="SheetTabs" Orientation="Horizontal" Spacing="2" />
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="{DynamicResource ChromeBackground}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,1,0,0" Padding="8,3">
            <DockPanel>
                <TextBlock x:Name="StatusCell" DockPanel.Dock="Left" Width="120" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusZoom" DockPanel.Dock="Right" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusCalc" DockPanel.Dock="Right" Margin="0,0,16,0" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusStats" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Command palette / sheet switcher overlay -->
        <Panel x:Name="OverlayHost" Grid.RowSpan="5" IsVisible="False" Background="#40000000" />
    </Grid>
</Window>
