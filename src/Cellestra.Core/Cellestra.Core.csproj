<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The pure brain: spreadsheet model, formula engine, recalc, styling, and
    .ods/CSV I/O. GOLDEN RULE #1: ZERO UI dependencies. No Avalonia.* here, ever.
    Only the .NET BCL (System.IO.Compression for ZIP, System.Xml for XML).
  -->
  <PropertyGroup>
    <RootNamespace>Cellestra.Core</RootNamespace>
    <AssemblyName>Cellestra.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The chart store. A sibling pure-logic library (no UI, no third-party charting dependency)
      that deliberately does NOT depend on Core, so this reference adds no cycle: Core resolves a
      chart's stored range strings to numbers and embeds/reads the ODF chart object on save/open.
    -->
    <ProjectReference Include="..\Cellestra.Charts\Cellestra.Charts.csproj" />
  </ItemGroup>

</Project>
