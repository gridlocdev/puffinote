{
  "name": "Cellestra (.NET 10)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  // Restore the solution once the container is built so IntelliSense and the
  // first `dotnet build` are fast. The desktop GUI itself can't run headlessly
  // (Avalonia.Native RenderTimer -6661 without a display link), so this targets
  // the build, the `cellestra` CLI, and the headless test suites.
  "postCreateCommand": "dotnet restore",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "AvaloniaTeam.vscode-avalonia",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "dotnet.defaultSolution": "Cellestra.slnx"
      }
    }
  },
  "remoteUser": "vscode"
}
