{
  "name": "Puffinote (Node 22)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "pnpm install",
  // The web dev server and the NAS server.
  "forwardPorts": [5173, 8790],
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "editorconfig.editorconfig"]
    }
  },
  "remoteUser": "node"
}
