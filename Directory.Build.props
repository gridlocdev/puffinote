<Project>

  <!-- Shared build settings for every project in the solution. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- IDE0060 (unused parameter) has no code-fixer and can't be auto-resolved: the parameter is
         often required by a delegate/interface/override signature, or is a placeholder for an
         as-yet-unwired feature (removing it would hide that signal). Keep it a visible warning
         rather than a build-breaking error so it surfaces without gating CI. -->
    <WarningsNotAsErrors>IDE0060</WarningsNotAsErrors>
    <!-- Generate the doc file so IDE0005 (unused usings) actually reports at build time. The doc
         file is a means to that end, not a shipped artifact, so suppress the XML-doc *validation*
         family: CS1591 (missing doc), CS1573 (partial <param>), CS1572/CS1734 (stale <param>/paramref).
         plus the cref-resolution family CS1574/CS0419/CS1580 (broken/ambiguous <see cref>).
         These flag doc-comment prose, not code; re-enable if you ever publish API docs. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS1734;CS1574;CS0419;CS1580;CS1570</NoWarn>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Keep build outputs OS-specific so artifacts built inside the Linux
    .devcontainer never collide with native macOS/Windows builds on the host.
    ($(OS) reports "Unix" for both macOS and Linux, so it can't be used here.)
  -->
  <PropertyGroup>
    <BuildOSToken Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</BuildOSToken>
    <BuildOSToken Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</BuildOSToken>
    <BuildOSToken Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows</BuildOSToken>
    <BaseOutputPath>bin/$(BuildOSToken)/</BaseOutputPath>
    <BaseIntermediateOutputPath>obj/$(BuildOSToken)/</BaseIntermediateOutputPath>
    <!--
      The SDK only excludes the *current* BaseIntermediateOutputPath (obj/<os>/) from the default
      source glob. Exclude the whole obj/ and bin/ trees so stale generated files left in the plain
      obj/ (e.g. from a build before these OS-specific paths, or other tooling) are never compiled —
      otherwise their AssemblyInfo.cs collides with the live one (CS0579 duplicate attributes).
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    Hermetic tests. Every test project compiles the same two files: a module initializer that points
    HOME and the XDG/AppData variables at a throwaway directory before any test runs, and the test that
    proves it did. Linked from one place rather than copied, but compiled *into* each assembly, because a
    module initializer only runs for the assembly that carries it.

    Applied here rather than per-project so a test project added tomorrow is hermetic without anyone
    remembering to opt in — which is the only version of this that keeps working.
  -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <Compile Include="$(MSBuildThisFileDirectory)shared/TestSupport/HermeticProfile.cs" Link="TestSupport/HermeticProfile.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)shared/TestSupport/HermeticProfileTests.cs" Link="TestSupport/HermeticProfileTests.cs" />
  </ItemGroup>

</Project>
