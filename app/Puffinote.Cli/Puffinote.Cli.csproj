<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The `puffinote` router (ARCHITECTURE.md §11) — the unified CLI over the two sub-CLIs plus
    notebook-scoped commands. GOLDEN RULE: no Avalonia, no network. It reuses the standalone
    typage/cellestra command trees verbatim (single source of truth), so the standalone binaries
    keep working unchanged. References the family's non-UI shell floor (Puffinote.Components.Core:
    shared CliException + CliHost run harness), both sub-CLIs (for their command definitions), and
    Cellestra.Core (to read .ods cell text for notebook search — the same read path NotebookSearchService
    uses in the shell).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Puffinote.Cli</RootNamespace>
    <AssemblyName>puffinote</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Puffinote.Components.Core\Puffinote.Components.Core.csproj" />
    <ProjectReference Include="..\..\features\EditMarkdown\Typage.Cli\Typage.Cli.csproj" />
    <ProjectReference Include="..\..\features\EditSpreadsheets\Cellestra.Cli\Cellestra.Cli.csproj" />
    <ProjectReference Include="..\..\features\EditSpreadsheets\Cellestra.Core\Cellestra.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Puffinote.Cli.Tests" />
  </ItemGroup>

</Project>
