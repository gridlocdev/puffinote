<Project>

  <!--
    Central package management — the SINGLE SOURCE OF TRUTH for dependency
    versions (ARCHITECTURE.md §2.1). Do not hardcode versions in .csproj files;
    add a <PackageVersion> here and reference it with a version-less
    <PackageReference> elsewhere. Bump deliberately, never incidentally.
  -->
  <PropertyGroup>
    <AvaloniaVersion>12.0.4</AvaloniaVersion>
  </PropertyGroup>

  <ItemGroup Label="Avalonia (UI — Cellestra.Desktop + UI tests)">
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Controls.ColorPicker" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup Label="Dependency injection (latest stable matching net10.0)">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup Label="CLI (Cellestra.Cli)">
    <PackageVersion Include="System.CommandLine" Version="2.0.8" />
  </ItemGroup>

  <ItemGroup Label="Testing (xUnit v3 for both test projects)">
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
  </ItemGroup>

  <ItemGroup Label="Benchmarks">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

</Project>
