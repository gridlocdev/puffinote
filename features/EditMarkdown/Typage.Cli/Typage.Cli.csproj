<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The command-line surface: a second consumer of Typage.Engine (alongside the Desktop
    shell), for CI/build pipelines and headless inspection. GOLDEN RULE: no Avalonia, no
    network. Only Typage.Engine + System.CommandLine.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Typage.Cli</RootNamespace>
    <AssemblyName>typage</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Typage.Engine\Typage.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Typage.Cli.Tests" />
  </ItemGroup>

</Project>
