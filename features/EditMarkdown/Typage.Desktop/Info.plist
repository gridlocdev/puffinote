<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS bundle metadata. CFBundleName is what the menu bar shows next to the Apple menu
     (the bold application menu), so a packaged Typage.app reads "Typage" rather than the
     process name. Assembled into Typage.app/Contents/Info.plist by build/package-mac.sh.

     Typage claims .md as Owner because it *is* the family's Markdown editor and App.cs opens a
     file passed on launch (the "Open With" / double-click path), so the association does what a
     user expects. Puffinote deliberately does not compete for it — see app/Puffinote.Desktop/Info.plist. -->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Typage</string>
    <key>CFBundleDisplayName</key>
    <string>Typage</string>
    <key>CFBundleIdentifier</key>
    <string>com.typage.Typage</string>
    <key>CFBundleExecutable</key>
    <string>Typage</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleIconFile</key>
    <string>Typage</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSRequiresAquaSystemAppearance</key>
    <false/>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Markdown Document</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>md</string>
                <string>markdown</string>
                <string>mdown</string>
                <string>mkd</string>
            </array>
            <key>LSItemContentTypes</key>
            <array>
                <string>net.daringfireball.markdown</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
