<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Avalonia 12 desktop shell: single window, menu bar, formatting toolbar, status bar,
       file dialogs, recent files, settings. A thin host around the embeddable MarkdownEditorView. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Typage.Desktop</RootNamespace>
    <AssemblyName>Typage</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>

  <ItemGroup>
    <!-- The embeddable editor surface. This app is a thin host that supplies the window,
         menu, file dialogs, and settings. -->
    <ProjectReference Include="..\Typage.Control\Typage.Control.csproj" />
    <ProjectReference Include="..\Typage.Engine\Typage.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Headless UI tests reach a few internal test seams. -->
    <InternalsVisibleTo Include="Typage.UiTests" />
  </ItemGroup>

</Project>
