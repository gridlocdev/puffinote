<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The embeddable Markdown editing surface: the custom live-preview control built on
    Avalonia.Media.TextFormatting, its MarkdownTheme (token type -> visual treatment) and
    IEmbedResolver seams, and the MarkdownEditorView that wraps it. Packaged as an Avalonia
    control library so both the standalone Typage.Desktop app and a host application (the Puffinote
    shell) can embed the surface unchanged.

    The surface is *whole*: it ships its own command catalog, the icon-driven command bar, the
    find/replace bar, and the dialogs that act on the open document (link, image, reference) over its
    own overlay layer. A host therefore gets Typage's entire editing experience by embedding one
    control, and the two shells cannot drift apart, because there is only one of everything.

    What stays in a shell is what needs a shell: the window, the native menu, which file is open
    (MarkdownDocumentSession), recent files, and settings.

    Dependency direction is strictly shell -> control -> engine; no upward references.
  -->
  <PropertyGroup>
    <RootNamespace>Typage.Control</RootNamespace>
    <AssemblyName>Typage.Control</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Typage.Engine\Typage.Engine.csproj" />
    <!-- Shared command types (AppCommand / Shortcut) so the control can publish its own editing catalog
         for a host's Command Palette, exactly as Cellestra.Editor does. Puffinote.Components is the shared
         floor (it depends only on Avalonia); this is control -> shared-floor, not an upward reference. -->
    <ProjectReference Include="..\..\..\shared\Puffinote.Components\Puffinote.Components.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The standalone app shell (assembly name "Typage") and the headless UI tests reach a few
         internal seams on the surface control. -->
    <InternalsVisibleTo Include="Typage" />
    <InternalsVisibleTo Include="Typage.UiTests" />
  </ItemGroup>

</Project>
