<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The embeddable plaintext editing surface: PlainTextEditor (custom-drawn, uniform rows, a line-number
    gutter, an optional wrap) and the PlainTextEditorView that wraps it with a find bar and its own
    command catalog. Packaged as an Avalonia control library so the standalone Plaintain.Desktop app and
    a host application (the Puffinote shell) embed the same surface unchanged.

    The surface is *whole*, as Typage's and Cellestra's are: every command that acts on the open document
    lives here, never in a shell — which is what keeps the standalone app and the Puffinote pane from
    drifting into two different editors.

    It is deliberately NOT built on Typage's MarkdownEditor (proposal 0003 §5). The semantics they share —
    graphemes, selection, undo, search — are in shared/Puffinote.Text and genuinely shared; the geometry
    is not, and a plaintext editor's geometry is row × lineHeight arithmetic where Typage's is a pixel
    prefix sum over variable-height blocks with collapsing margins.

    Dependency direction is strictly shell -> control -> shared; no upward references.
  -->
  <PropertyGroup>
    <RootNamespace>Plaintain.Control</RootNamespace>
    <AssemblyName>Plaintain.Control</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\shared\Puffinote.Text\Puffinote.Text.csproj" />
    <!-- Shared command types (AppCommand / Shortcut) and chrome tokens, so the control can publish its own
         editing catalog for a host's Command Palette exactly as the sibling editors do. -->
    <ProjectReference Include="..\..\..\shared\Puffinote.Components\Puffinote.Components.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The standalone app shell (assembly name "Plaintain") and the headless UI tests reach a few
         internal seams on the surface control. -->
    <InternalsVisibleTo Include="Plaintain" />
    <InternalsVisibleTo Include="Plaintain.UiTests" />
  </ItemGroup>

</Project>
