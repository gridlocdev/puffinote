<Project Sdk="Microsoft.NET.Sdk">

  <!--
    `plaintain` — a launcher, plus exactly one read-only probe (proposal 0003 §9.3). It opens files in
    Plaintain.Desktop, and `plaintain info` prints what a text file is made of. It is deliberately not the
    start of a verb surface: a plaintext editor has no operations a shell doesn't already have.

    The binary is the app's full name. Proposal 0003 spelled it `pltn`; every CLI in the family is now
    named for its app, because one family with two naming schemes is a thing to remember rather than a
    thing to know.

    GOLDEN RULE: no Avalonia, no network. Puffinote.Text + System.CommandLine + the family's non-UI
    shell floor (Puffinote.Components.Core: the shared CliException + CliHost run harness).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Plaintain.Cli</RootNamespace>
    <AssemblyName>plaintain</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\shared\Puffinote.Text\Puffinote.Text.csproj" />
    <ProjectReference Include="..\..\..\shared\Puffinote.Components.Core\Puffinote.Components.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Plaintain.Cli.Tests" />
  </ItemGroup>

</Project>
