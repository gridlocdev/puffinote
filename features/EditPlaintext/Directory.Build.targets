<Project>

  <!--
    Dependency-allowlist gate (Plaintain PRD §5; the supply-chain golden rule, enforced).
    The trusted base is the .NET BCL + first-party Avalonia (+ its native deps) + OS services,
    plus the test/benchmark/CLI tooling below. This target fails the build of any Plaintain project
    that references a NuGet package outside that base — so a stray "add a Markdown/PDF/editor
    library" never lands silently. To add a dependency: state the reason, then append its id to
    AllowedPackage here. Scoped to features/EditPlaintext only (each area has its own tree).
  -->
  <ItemGroup>
    <AllowedPackage Include="Avalonia" />
    <AllowedPackage Include="Avalonia.Desktop" />
    <AllowedPackage Include="Avalonia.Themes.Fluent" />
    <AllowedPackage Include="Avalonia.Fonts.Inter" />
    <AllowedPackage Include="Avalonia.Headless.XUnit" />
    <AllowedPackage Include="System.CommandLine" />
    <AllowedPackage Include="xunit.v3" />
    <AllowedPackage Include="xunit.runner.visualstudio" />
    <AllowedPackage Include="Microsoft.NET.Test.Sdk" />

    <!--
      BenchmarkDotNet: the harness for the 50 MB load path (proposal 0003 §9.5 — measure before
      optimising). Development-time only, referenced by Plaintain.Benchmarks alone and by nothing that
      ships; the same allowance Typage and Cellestra already make for their harnesses.
    -->
    <AllowedPackage Include="BenchmarkDotNet" />
  </ItemGroup>

  <Target Name="CheckDependencyAllowlist" BeforeTargets="CollectPackageReferences;Build">
    <PropertyGroup>
      <!-- ";A;B;C;" — delimited so the membership test is exact, not a substring match. -->
      <_AllowedPackages>;@(AllowedPackage);</_AllowedPackages>
    </PropertyGroup>
    <Error
      Condition="'%(PackageReference.Identity)' != '' and !$(_AllowedPackages.Contains(';%(PackageReference.Identity);'))"
      Text="Disallowed NuGet dependency '%(PackageReference.Identity)' — outside the Plaintain trusted base (PRD §5). State a reason and add it to AllowedPackage in features/EditPlaintext/Directory.Build.targets, or remove the package." />
  </Target>

</Project>
