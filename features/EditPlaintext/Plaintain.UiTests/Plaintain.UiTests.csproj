<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless Avalonia 12 UI tests. xUnit v3 via Avalonia.Headless.XUnit. The devcontainer can't
       launch a GUI, so this suite is the gate for anything the surface draws or answers to. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Plaintain.UiTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plaintain.Control\Plaintain.Control.csproj" />
    <ProjectReference Include="..\Plaintain.Desktop\Plaintain.Desktop.csproj" />
  </ItemGroup>

</Project>
