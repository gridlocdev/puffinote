<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS bundle metadata. CFBundleName is what the menu bar shows next to the Apple menu, so a
     packaged Plaintain.app reads "Plaintain" rather than the process name. Assembled into
     Plaintain.app/Contents/Info.plist by build/package-mac.sh.

     The document claims follow proposal 0003 §7, which is two rules and no more:

       Owner, narrowly — only the extensions nobody else wants (txt/text/log and the
       public.plain-text UTI). Typage keeps md/markdown as Owner; Puffinote claims nothing.

       Alternate, broadly — the long tail (conf, ini, json, yaml, sh, csv, …) at Alternate rank,
       which puts Plaintain in "Open With" without taking anyone's default away. Claiming json or
       yaml as Owner is a fight with every editor and IDE on the machine, and one users would
       rightly resent losing. -->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Plaintain</string>
    <key>CFBundleDisplayName</key>
    <string>Plaintain</string>
    <key>CFBundleIdentifier</key>
    <string>com.plaintain.Plaintain</string>
    <key>CFBundleExecutable</key>
    <string>Plaintain</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleIconFile</key>
    <string>Plaintain</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSRequiresAquaSystemAppearance</key>
    <false/>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Plain Text Document</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>txt</string>
                <string>text</string>
                <string>log</string>
            </array>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.plain-text</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Text File</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>conf</string>
                <string>cfg</string>
                <string>ini</string>
                <string>env</string>
                <string>csv</string>
                <string>tsv</string>
                <string>yaml</string>
                <string>yml</string>
                <string>toml</string>
                <string>xml</string>
                <string>json</string>
                <string>sh</string>
                <string>md5</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
