<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Avalonia 12 desktop app: window, menu bar, ribbon, grid, dialogs. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Cellestra.Desktop</RootNamespace>
    <AssemblyName>Cellestra</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <!-- First-party Avalonia color picker (MIT, community license). See docs/ARCHITECTURE.md §2.1. -->
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <!-- The embeddable editor: grid, chrome, dialogs, command catalog, icons. This app is now a thin
         host around its SpreadsheetEditorView, supplying the window, native menu, and file dialogs. -->
    <ProjectReference Include="..\Cellestra.Editor\Cellestra.Editor.csproj" />
    <ProjectReference Include="..\Cellestra.Core\Cellestra.Core.csproj" />
    <!-- The chart store: chart-sheet model used by the chart view and its custom renderer. -->
    <ProjectReference Include="..\Cellestra.Charts\Cellestra.Charts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Headless UI tests reach a few internal test seams (e.g. signature-help state). -->
    <InternalsVisibleTo Include="Cellestra.UiTests" />
  </ItemGroup>

</Project>
