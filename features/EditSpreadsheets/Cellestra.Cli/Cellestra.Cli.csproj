<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The command-line surface: a third consumer of Cellestra.Core (alongside the
    Desktop app), for CI/build pipelines. GOLDEN RULE: no Avalonia, no network.
    Cellestra.Core + System.CommandLine + the family's non-UI shell floor
    (Puffinote.Components.Core: shared CliException + CliHost run harness).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Cellestra.Cli</RootNamespace>
    <AssemblyName>cellestra</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <!--
    The agent skill ships inside the binary (`cellestra skill [-install]`), so an installed
    cellestra can hand its own instructions to any agent host, anywhere. The repo copy under
    .claude/skills/ is the source of truth — it's what agents working in this repo load directly.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\.claude\skills\cellestra\SKILL.md" LogicalName="SKILL.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cellestra.Core\Cellestra.Core.csproj" />
    <ProjectReference Include="..\..\..\shared\Puffinote.Components.Core\Puffinote.Components.Core.csproj" />
  </ItemGroup>

</Project>
