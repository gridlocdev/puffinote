<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The embeddable board: BoardView, ListView, the task dialog, and the one command catalog
    TaskEditingCommands. Puffinote embeds this unchanged, so every command that acts on the document
    lives here and never in a shell.

    THE DELIBERATE DIVERGENCE (proposal 0004 §5): this control uses STOCK AVALONIA CONTROLS, not a
    custom-drawn surface. Typage and Cellestra draw their own because no stock control can be a
    live-preview text editor or a spreadsheet grid. A Kanban board is ItemsControl + panels + Avalonia's
    drag-and-drop — well-trodden ground where custom drawing would cost thousands of lines and buy
    nothing. This is recorded here so nobody reading a sibling AGENTS.md "corrects" it.
  -->
  <PropertyGroup>
    <RootNamespace>Pivotask.Control</RootNamespace>
    <AssemblyName>Pivotask.Control</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pivotask.Core\Pivotask.Core.csproj" />
    <ProjectReference Include="..\..\..\shared\Puffinote.Components\Puffinote.Components.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pivotask" />
    <InternalsVisibleTo Include="Pivotask.UiTests" />
  </ItemGroup>

</Project>
