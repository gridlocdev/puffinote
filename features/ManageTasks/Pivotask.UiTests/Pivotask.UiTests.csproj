<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless Avalonia 12 UI tests. xUnit v3 via Avalonia.Headless.XUnit. The devcontainer can't
       launch a GUI, so this suite is the gate for anything the board draws or answers to. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Pivotask.UiTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pivotask.Control\Pivotask.Control.csproj" />
    <ProjectReference Include="..\Pivotask.Desktop\Pivotask.Desktop.csproj" />
  </ItemGroup>

</Project>
